{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "Source": {
    "File": {
      "Path": "Samples/sample-message.xml"
    }
  },
  "Email": {
    "Provider": "Logging",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "From": "",
      "UserName": "",
      "Password": ""
    }
  },
  "Partners": {
    "A": {
      "Recipient": "partner-a@example.com"
    },
    "B": {
      "EventType": "ISSUED",
      "OutputDirectory": "out/partner-b"
    }
  }
}
